{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": false,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 5,
  "rebaseWhen": "conflicted",
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "extends": ["schedule:weekly"]
  },
  "packageRules": [
    {
      "matchManagers": ["nix"],
      "separateMinorPatch": true,
      "separateMajorMinor": true
    }
  ]
}
